rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /subscriptions/{subscriptionId} {
      allow read: if signedIn() && (request.auth.uid == resource.data.userId || isSupport());
      allow delete: if signedIn() && !isStaff() && request.auth.uid == resource.data.userId;
      allow update: if request.auth != null 
                    && !isStaff()
                    && request.auth.uid == resource.data.userId 
                    && request.resource.data.userId == resource.data.userId;
      allow create: if request.auth != null
                    && !isStaff()
                    && request.auth.uid == request.resource.data.userId;
    }
    
    function signedIn() { return request.auth != null; }
    function requesterRole() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user'); }
    function isAdmin() { return signedIn() && requesterRole() == 'admin'; }
    function isStaff() { return signedIn() && requesterRole() == 'staff'; }
    function isSupport() { return isStaff() || isAdmin(); }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }

    function isValidSupportStatus(status) {
      return status == 'open' || status == 'in_progress' || status == 'resolved';
    }

    function isValidSupportPriority(priority) {
      return priority == 'low' || priority == 'normal' || priority == 'high';
    }

    function isValidSupportCategory(category) {
      return category == 'account' || category == 'subscription' || category == 'premium'
             || category == 'billing' || category == 'other';
    }

    function isValidSupportSubject(subject) {
      return subject is string
             && subject.size() > 0
             && subject.size() <= 160
             && subject.matches('.*[^\\s].*');
    }

    function isValidSupportAssignment(assignedTo) {
      return assignedTo == null
             || (assignedTo is string
                 && assignedTo.size() > 0
                 && assignedTo.size() <= 128
                 && exists(/databases/$(database)/documents/users/$(assignedTo))
                 && (get(/databases/$(database)/documents/users/$(assignedTo)).data.get('role', 'user') == 'staff'
                     || get(/databases/$(database)/documents/users/$(assignedTo)).data.get('role', 'user') == 'admin'));
    }

    function isValidSupportCaseCreate() {
      return isSupport()
             && request.resource.data.keys().hasOnly([
                  'userId', 'subject', 'category', 'status', 'priority', 'createdBy',
                  'createdByRole', 'assignedTo', 'createdAt', 'updatedAt', 'resolvedAt'
                ])
             && request.resource.data.userId is string
             && request.resource.data.userId.size() > 0
             && request.resource.data.userId.size() <= 128
             && exists(/databases/$(database)/documents/users/$(request.resource.data.userId))
             && isValidSupportSubject(request.resource.data.subject)
             && isValidSupportCategory(request.resource.data.category)
             && request.resource.data.status == 'open'
             && isValidSupportPriority(request.resource.data.priority)
             && request.resource.data.createdBy == request.auth.uid
             && request.resource.data.createdByRole == requesterRole()
             && request.resource.data.assignedTo == null
             && request.resource.data.createdAt == request.time
             && request.resource.data.updatedAt == request.time
             && request.resource.data.resolvedAt == null;
    }

    function isValidSupportWorkflowValues() {
      let statusChanged = request.resource.data.status != resource.data.status;
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'priority', 'assignedTo', 'updatedAt', 'resolvedAt'])
             && isValidSupportStatus(request.resource.data.status)
             && isValidSupportPriority(request.resource.data.priority)
             && isValidSupportAssignment(request.resource.data.assignedTo)
             && request.resource.data.updatedAt == request.time
             && ((!statusChanged && request.resource.data.resolvedAt == resource.data.resolvedAt)
                 || (statusChanged && request.resource.data.status == 'resolved'
                     && request.resource.data.resolvedAt == request.time)
                 || (statusChanged && request.resource.data.status != 'resolved'
                     && request.resource.data.resolvedAt == null));
    }

    function isValidStaffSupportCaseUpdate() {
      let oldStatus = resource.data.status;
      let newStatus = request.resource.data.status;
      let oldAssignee = resource.data.assignedTo;
      let newAssignee = request.resource.data.assignedTo;
      return isStaff()
             && isValidSupportWorkflowValues()
             && oldStatus != 'resolved'
             && ((oldStatus == 'open' && (newStatus == 'open' || newStatus == 'in_progress'))
                 || (oldStatus == 'in_progress' && (newStatus == 'in_progress' || newStatus == 'resolved')))
             && ((oldAssignee == null && (newAssignee == null || newAssignee == request.auth.uid))
                 || (oldAssignee != null && newAssignee == oldAssignee))
             && (newStatus != 'in_progress' || newAssignee == request.auth.uid)
             && (newStatus != 'resolved' || oldAssignee == request.auth.uid);
    }

    function isValidAdminSupportCaseUpdate() {
      return isAdmin() && isValidSupportWorkflowValues();
    }

    function isValidSupportNoteCreate(parentCaseId) {
      return isSupport()
             && exists(/databases/$(database)/documents/support_cases/$(parentCaseId))
             && request.resource.data.keys().hasOnly(['authorId', 'authorRole', 'message', 'createdAt'])
             && request.resource.data.authorId == request.auth.uid
             && request.resource.data.authorRole == requesterRole()
             && request.resource.data.message is string
             && request.resource.data.message.size() > 0
             && request.resource.data.message.size() <= 2000
             && request.resource.data.message.matches('.*[^\\s].*')
             && request.resource.data.createdAt == request.time;
    }

    function isValidStaffEmailSync(targetUserId) {
      let oldEmail = resource.data.get('email', null);
      let authEmail = request.auth.token.get('email', null);
      return isOwner(targetUserId)
             && resource.data.get('role', 'user') == 'staff'
             && request.resource.data.get('role', 'user') == 'staff'
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email'])
             && (oldEmail == null || (oldEmail is string && oldEmail.matches('^\\s*$')))
             && authEmail is string
             && authEmail.matches('.*[^\\s].*')
             && request.resource.data.get('email', null) == authEmail;
    }

    function isValidAuthDisplayNameSync(targetUserId) {
      let oldName = resource.data.get('displayName', null);
      let authName = request.auth.token.get('name', null);
      return isOwner(targetUserId)
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
             && (oldName == null || (oldName is string && oldName.matches('^\\s*$')))
             && authName is string
             && authName.size() > 0
             && authName.size() <= 160
             && authName.matches('.*[^\\s].*')
             && request.resource.data.get('displayName', null) == authName;
    }

    function isValidAdminRoleTransition(targetUserId) {
      let oldRole = resource.data.get('role', 'user');
      let newRole = request.resource.data.get('role', 'user');
      let oldPlan = resource.data.get('plan', oldRole == 'premium' ? 'premium' : 'free');
      let newPlan = request.resource.data.get('plan', 'free');
      return request.auth.uid != targetUserId
             && oldRole != 'admin'
             && (oldRole == 'user' || oldRole == 'staff' || oldRole == 'premium')
             && (newRole == 'user' || newRole == 'staff')
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'plan'])
             && ((oldRole == 'premium' && newPlan == 'premium')
                 || (oldRole != 'premium' && newPlan == oldPlan));
    }

    function isValidLegacyPremiumMigration(targetUserId) {
      return isOwner(targetUserId)
             && resource.data.get('role', 'user') == 'premium'
             && request.resource.data.get('role', 'user') == 'user'
             && request.resource.data.get('plan', 'free') == 'premium'
             && request.resource.data.premiumPlan == 'lifetime'
             && request.resource.data.premiumUntil == null
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'plan', 'premiumPlan', 'premiumUntil']);
    }

    function isValidPremiumPrice(plan, amount) {
      return (plan == 'monthly' && amount == 29)
             || (plan == 'yearly' && amount == 199)
             || (plan == 'lifetime' && amount == 299);
    }

    function isValidPremiumDuration(plan, premiumUntil) {
      return (plan == 'lifetime' && premiumUntil == null)
             || (plan == 'monthly'
                 && premiumUntil is timestamp
                 && premiumUntil >= request.time + duration.value(27, 'd')
                 && premiumUntil <= request.time + duration.value(32, 'd'))
             || (plan == 'yearly'
                 && premiumUntil is timestamp
                 && premiumUntil >= request.time + duration.value(364, 'd')
                 && premiumUntil <= request.time + duration.value(367, 'd'));
    }

    function isValidSelfPremiumUpgrade(targetUserId) {
      let purchasePath = /databases/$(database)/documents/premium_purchases/$(targetUserId);
      let purchaseAfter = getAfter(purchasePath).data;
      let role = resource.data.get('role', 'user');
      return isOwner(targetUserId)
             && role == 'user'
             && request.resource.data.get('role', 'user') == role
             && request.resource.data.get('plan', 'free') == 'premium'
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['plan', 'premiumPlan', 'premiumSince', 'premiumUntil'])
             && (request.resource.data.premiumPlan == 'monthly'
                 || request.resource.data.premiumPlan == 'yearly'
                 || request.resource.data.premiumPlan == 'lifetime')
             && request.resource.data.premiumSince == request.time
             && isValidPremiumDuration(request.resource.data.premiumPlan, request.resource.data.premiumUntil)
             && purchaseAfter.keys().hasOnly(['userId', 'plan', 'amount', 'currency', 'status', 'createdAt', 'premiumUntil'])
             && purchaseAfter.userId == request.auth.uid
             && purchaseAfter.plan == request.resource.data.premiumPlan
             && isValidPremiumPrice(purchaseAfter.plan, purchaseAfter.amount)
             && purchaseAfter.currency == 'THB'
             && purchaseAfter.status == 'approved'
             && purchaseAfter.createdAt == request.resource.data.premiumSince
             && purchaseAfter.premiumUntil == request.resource.data.premiumUntil;
    }

    function isValidPremiumPurchase(targetUserId) {
      let userPath = /databases/$(database)/documents/users/$(targetUserId);
      let userBefore = get(userPath).data;
      let userAfter = getAfter(userPath).data;
      let role = userBefore.get('role', 'user');
      return isOwner(targetUserId)
             && role == 'user'
             && request.resource.data.keys().hasOnly(['userId', 'plan', 'amount', 'currency', 'status', 'createdAt', 'premiumUntil'])
             && request.resource.data.userId == request.auth.uid
             && (request.resource.data.plan == 'monthly'
                 || request.resource.data.plan == 'yearly'
                 || request.resource.data.plan == 'lifetime')
             && isValidPremiumPrice(request.resource.data.plan, request.resource.data.amount)
             && isValidPremiumDuration(request.resource.data.plan, request.resource.data.premiumUntil)
             && request.resource.data.currency == 'THB'
             && request.resource.data.status == 'approved'
             && request.resource.data.createdAt == request.time
             && userAfter.get('role', 'user') == role
             && userAfter.get('plan', 'free') == 'premium'
             && userAfter.premiumPlan == request.resource.data.plan
             && userAfter.premiumSince == request.resource.data.createdAt
             && userAfter.premiumUntil == request.resource.data.premiumUntil;
    }

    function isValidAdminPremiumState(data) {
      return (data.get('plan', 'free') == 'free'
              && data.premiumPlan == null
              && data.premiumSince == null
              && data.premiumUntil == null)
             || (data.get('plan', 'free') == 'premium'
                 && (data.premiumPlan == 'monthly' || data.premiumPlan == 'yearly' || data.premiumPlan == 'lifetime')
                 && data.premiumSince == request.time
                 && ((data.premiumPlan == 'lifetime' && data.premiumUntil == null)
                     || ((data.premiumPlan == 'monthly' || data.premiumPlan == 'yearly') && data.premiumUntil is timestamp)));
    }

    function isValidAdminPremiumOverride(targetUserId) {
      let auditId = request.resource.data.lastPremiumAuditId;
      let auditPath = /databases/$(database)/documents/admin_audit_logs/$(auditId);
      let auditAfter = getAfter(auditPath).data;
      let oldRole = resource.data.get('role', 'user');
      let oldPlan = resource.data.get('plan', oldRole == 'premium' ? 'premium' : 'free');
      return isAdmin()
             && request.auth.uid != targetUserId
             && oldRole != 'admin'
             && request.resource.data.get('role', 'user') == oldRole
             && auditId is string
             && auditId.size() > 0
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['plan', 'premiumPlan', 'premiumSince', 'premiumUntil', 'lastPremiumAuditId'])
             && isValidAdminPremiumState(request.resource.data)
             && auditAfter.action == 'premium_override'
             && auditAfter.targetUserId == targetUserId
             && auditAfter.adminUserId == request.auth.uid
             && auditAfter.previousPlan == oldPlan
             && auditAfter.previousPremiumPlan == resource.data.get('premiumPlan', null)
             && auditAfter.previousPremiumUntil == resource.data.get('premiumUntil', null)
             && auditAfter.newPlan == request.resource.data.plan
             && auditAfter.newPremiumPlan == request.resource.data.premiumPlan
             && auditAfter.newPremiumUntil == request.resource.data.premiumUntil
             && auditAfter.createdAt == request.time;
    }

    function isValidPremiumAuditLog(auditId) {
      let targetUserId = request.resource.data.targetUserId;
      let userPath = /databases/$(database)/documents/users/$(targetUserId);
      let userBefore = get(userPath).data;
      let userAfter = getAfter(userPath).data;
      let oldRole = userBefore.get('role', 'user');
      let oldPlan = userBefore.get('plan', oldRole == 'premium' ? 'premium' : 'free');
      return isAdmin()
             && request.auth.uid != targetUserId
             && oldRole != 'admin'
             && request.resource.data.keys().hasOnly([
                  'action', 'targetUserId', 'adminUserId', 'previousPlan', 'previousPremiumPlan',
                  'previousPremiumUntil', 'newPlan', 'newPremiumPlan', 'newPremiumUntil', 'reason', 'createdAt'
                ])
             && request.resource.data.action == 'premium_override'
             && request.resource.data.targetUserId is string
             && request.resource.data.targetUserId.size() > 0
             && request.resource.data.adminUserId == request.auth.uid
             && request.resource.data.previousPlan == oldPlan
             && request.resource.data.previousPremiumPlan == userBefore.get('premiumPlan', null)
             && request.resource.data.previousPremiumUntil == userBefore.get('premiumUntil', null)
             && request.resource.data.newPlan == userAfter.plan
             && request.resource.data.newPremiumPlan == userAfter.premiumPlan
             && request.resource.data.newPremiumUntil == userAfter.premiumUntil
             && request.resource.data.reason is string
             && request.resource.data.reason.size() > 0
             && request.resource.data.reason.size() <= 500
             && request.resource.data.reason.matches('.*[^\\s].*')
             && request.resource.data.createdAt == request.time
             && userAfter.lastPremiumAuditId == auditId;
    }

    // New Schema Rules
    match /users/{userId} {
      allow read: if isOwner(userId) || isSupport();
      allow delete: if signedIn() && (
                      (isOwner(userId) && (resource.data.get('role', 'user') == 'user' || resource.data.get('role', 'user') == 'premium'))
                      || (isAdmin() && request.auth.uid != userId && resource.data.get('role', 'user') != 'admin')
                    );
      allow create: if isOwner(userId)
                    && request.resource.data.get('role', 'user') == 'user'
                    && request.resource.data.get('plan', 'free') == 'free'
                    && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && (
                       (isOwner(userId)
                        && resource.data.get('role', 'user') != 'staff'
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'plan', 'premiumPlan', 'premiumSince', 'premiumUntil', 'lastPremiumAuditId']))
                       || isValidStaffEmailSync(userId)
                       || isValidAuthDisplayNameSync(userId)
                       || (isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'plan', 'premiumPlan', 'premiumSince', 'premiumUntil', 'lastPremiumAuditId']))
                       || (isAdmin() && isValidAdminRoleTransition(userId))
                       || isValidAdminPremiumOverride(userId)
                       || isValidLegacyPremiumMigration(userId)
                       || isValidSelfPremiumUpgrade(userId)
                     );
      
      match /subscriptions/{subscriptionId} {
        allow read: if isOwner(userId) || isSupport();
        allow delete: if isOwner(userId) && !isStaff();
        allow update: if request.auth != null && !isStaff() && request.auth.uid == userId 
                      && request.resource.data.userId == resource.data.userId;
        allow create: if request.auth != null && !isStaff() && request.auth.uid == userId 
                      && request.resource.data.userId == userId;
      }
    }

    match /premium_purchases/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create, update: if request.auth != null && isValidPremiumPurchase(userId);
    }

    match /admin_audit_logs/{auditId} {
      allow read: if isAdmin();
      allow create: if signedIn() && isValidPremiumAuditLog(auditId);
      allow update, delete: if false;
    }

    match /support_cases/{caseId} {
      allow read: if isSupport();
      allow create: if isValidSupportCaseCreate();
      allow update: if isValidStaffSupportCaseUpdate() || isValidAdminSupportCaseUpdate();
      allow delete: if false;

      match /notes/{noteId} {
        allow read: if isSupport();
        allow create: if isValidSupportNoteCreate(caseId);
        allow update, delete: if false;
      }
    }

    // Payment History Rules
    match /payment_history/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && !isStaff() && request.auth.uid == resource.data.userId;
      allow update: if request.auth != null 
                    && !isStaff()
                    && request.auth.uid == resource.data.userId 
                    && request.resource.data.userId == resource.data.userId;
      allow create: if request.auth != null && !isStaff() && request.auth.uid == request.resource.data.userId;
    }
    
    // Canceled Subs (Graveyard) Rules
    match /canceled_subs/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && !isStaff() && request.auth.uid == resource.data.userId;
      allow update: if request.auth != null 
                    && !isStaff()
                    && request.auth.uid == resource.data.userId 
                    && request.resource.data.userId == resource.data.userId;
      allow create: if request.auth != null && !isStaff() && request.auth.uid == request.resource.data.userId;
    }
  }
}
